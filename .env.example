# GRWM Environment Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-secret-key
WTF_CSRF_SECRET_KEY=change-this-to-a-secure-csrf-secret-key

